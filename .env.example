# Server-only values from your Upstash Redis database REST API settings.
# Copy to .env.local for local testing. Set these in Vercel for hosted games.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only MongoDB settings. Keep redis selected until migration is verified.
GAMBIT_STORAGE=mongodb
MONGODB_URI=
MONGODB_DB=chessnexa

# Isolated local tests only: set true with GAMBIT_DATA_DIRECTORY in the test process.
# Never enable this on Vercel. It prevents .env.local Redis settings from being used.
GAMBIT_LOCAL_STORAGE=false

# Public site details, used for sitemap and contact pages. Set these in Vercel.
SITE_URL=https://chessnexa.in
SITE_OPERATOR=
SUPPORT_EMAIL=

# Google Analytics 4 (public measurement ID; loaded only in production builds).
# Set GOOGLE_ANALYTICS_ENABLED=false to disable tracking, then rebuild/redeploy.
GOOGLE_ANALYTICS_ID=G-6P7MVWK6YT
GOOGLE_ANALYTICS_ENABLED=true

# Google OAuth web application (server-only; never use NEXT_PUBLIC_).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a strong random secret, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
# Local: http://localhost:3000. Production: your exact HTTPS site origin.
NEXTAUTH_URL=https://chessnexa.in

# Comma-separated Google account emails allowed to access /moderation.
# Server-only. Leave empty to disable moderator access.
MODERATOR_EMAILS=

# Only this verified Google account can open /admin. Both values must match.
# These are server-only; never add NEXT_PUBLIC_ prefixes.
ADMIN_USER_ID=
ADMIN_EMAIL=

# Optional direct sponsor. All fields required; URL must use HTTPS.
# Leave empty to show only ChessNexa learning recommendations.
SPONSOR_NAME=
SPONSOR_TITLE=
SPONSOR_TEXT=
SPONSOR_URL=

# Optional scheduler calling /api/cron/events with Authorization: Bearer <secret>.
# Without a scheduler, automatic events advance when clients poll or games finish.
CRON_SECRET=
# Backup CLI only. Generate 32 random bytes encoded as base64; keep the key separately.
GAMBIT_BACKUP_KEY=
GAMBIT_BACKUP_DIRECTORY=.gambit-backups
# Optional authenticated master-game explorer. Never use NEXT_PUBLIC_ for this token.
LICHESS_API_TOKEN=
